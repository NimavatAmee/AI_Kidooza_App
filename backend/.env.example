# Kidooza Backend Environment Configuration

# Server
PORT=5001
NODE_ENV=development

# Database (PostgreSQL / Supabase connection URL)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kidooza_db?schema=public"

# Parent Security
JWT_SECRET="kidooza-dev-secret-change-in-production-2026"

# Child Safety Thresholds (DPDP Compliance)
MAX_SESSION_MINUTES=45
DEFAULT_SESSION_MINUTES=20
